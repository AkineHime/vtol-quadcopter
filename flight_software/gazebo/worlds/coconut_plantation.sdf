    <model name="overview_cam"><static>true</static><pose>95.0 -50.0 70 0 0.42 2.27</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <update_rate>5</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>1.1</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.2</near><far>400</far></clip>
            <save enabled="true"><path>/home/dev/simruns/demo_hybrid4/frames/overview</path></save></camera>
        </sensor></link></model>
    
    <model name="coconut_quadplane"><pose>0 0 0.11 0 0 -1.5708</pose>  <!-- on top of the 0.1 m dock pad -->
      <include merge="true"><uri>model://coconut_quadplane</uri></include>
      <!-- 10 mg: a fixed-joint link is lumped into base_link, and at 7.6 m a
           1 g "massless" camera added 0.06 kg m^2 -- doubling pitch/yaw inertia
           in recorded runs only -->
      <link name="chase_link"><pose>-7 0 3.0 0 0.38 0</pose>
        <inertial><mass>0.00001</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
        
        <sensor name="chase" type="camera">
          <update_rate>10</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.2</near><far>400</far></clip>
            <save enabled="true"><path>/home/dev/simruns/demo_hybrid4/frames/chase</path></save></camera>
        </sensor></link>
      <joint name="chase_joint" type="fixed"><parent>base_link</parent><child>chase_link</child></joint>
      <link name="nosecam_link"><pose>0.30 0 -0.03 0 1.0472 0</pose>
        <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
        
        <sensor name="esp32cam" type="camera">
          <update_rate>2</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>1.047</horizontal_fov>
            <image><width>800</width><height>600</height><format>R8G8B8</format></image>
            <clip><near>0.2</near><far>400</far></clip>
            <save enabled="true"><path>/home/dev/simruns/demo_hybrid4/frames/esp32cam</path></save></camera>
        </sensor></link>
      <joint name="nosecam_joint" type="fixed"><parent>base_link</parent><child>nosecam_link</child></joint>
    </model>
  </world>
