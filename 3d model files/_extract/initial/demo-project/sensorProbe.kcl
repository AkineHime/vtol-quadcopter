// Nose sensor probe
// Tapered forward probe matching the reference silhouette.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

probeTipSketch = sketch(on = offsetPlane(YZ, offset = -120mm)) {
  section = circle(start = [var 1.5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 1.5mm
}
probeTipRegion = region(segments = [probeTipSketch.section])

probeMidSketch = sketch(on = offsetPlane(YZ, offset = 70mm)) {
  section = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 5mm
}
probeMidRegion = region(segments = [probeMidSketch.section])

probeBaseSketch = sketch(on = offsetPlane(YZ, offset = 120mm)) {
  section = circle(start = [var 8mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 8mm
}
probeBaseRegion = region(segments = [probeBaseSketch.section])

sensorProbe = loft(
  [
    probeTipRegion,
    probeMidRegion,
    probeBaseRegion
  ],
  vDegree = 2,
  bezApproximateRational = true,
)
  |> appearance(color = "#D8DDDE", metalness = 22, roughness = 28)

hide([
  probeTipSketch,
  probeMidSketch,
  probeBaseSketch
])
sensorProbe
