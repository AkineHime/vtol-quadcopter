// Lift-motor boom
// Slender longitudinal composite tube supporting two lift pods.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

boomProfile = sketch(on = YZ) {
  outerCircle = circle(start = [var 22mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([outerCircle.center, ORIGIN])
  horizontal([outerCircle.center, outerCircle.start])
  radius(outerCircle) == 22mm
}
boomRegion = region(segments = [boomProfile.outerCircle])
liftBoom = extrude(boomRegion, length = 1320mm, symmetric = true)
  |> appearance(color = "#DDE3E5", roughness = 27)

hide(boomProfile)
liftBoom
