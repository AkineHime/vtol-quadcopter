// Lift-motor nacelle
// Lofted spindle pod matching the streamlined VTOL housings.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

frontTipSketch = sketch(on = offsetPlane(YZ, offset = -185mm)) {
  section = circle(start = [var 8mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 8mm
}
frontTipRegion = region(segments = [frontTipSketch.section])

frontShoulderSketch = sketch(on = offsetPlane(YZ, offset = -125mm)) {
  section = circle(start = [var 38mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 38mm
}
frontShoulderRegion = region(segments = [frontShoulderSketch.section])

podCenterSketch = sketch(on = YZ) {
  section = circle(start = [var 53mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 53mm
}
podCenterRegion = region(segments = [podCenterSketch.section])

rearShoulderSketch = sketch(on = offsetPlane(YZ, offset = 125mm)) {
  section = circle(start = [var 34mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 34mm
}
rearShoulderRegion = region(segments = [rearShoulderSketch.section])

rearTipSketch = sketch(on = offsetPlane(YZ, offset = 185mm)) {
  section = circle(start = [var 7mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([section.center, ORIGIN])
  horizontal([section.center, section.start])
  radius(section) == 7mm
}
rearTipRegion = region(segments = [rearTipSketch.section])

motorPod = loft(
  [
    frontTipRegion,
    frontShoulderRegion,
    podCenterRegion,
    rearShoulderRegion,
    rearTipRegion
  ],
  vDegree = 2,
  bezApproximateRational = true,
)
  |> scale(
       x = 1,
       y = 1,
       z = 0.72,
       global = false,
     )
  |> appearance(color = "#E9EDEF", roughness = 25)

hide([
  frontTipSketch,
  frontShoulderSketch,
  podCenterSketch,
  rearShoulderSketch,
  rearTipSketch
])

motorPod
