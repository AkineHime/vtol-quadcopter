// Blended VTOL fuselage
// Lofted stations form the tapered central UAV body.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

noseTipSketch = sketch(on = offsetPlane(YZ, offset = -1080mm)) {
  section = circle(start = [var 12mm, var -35mm], center = [var 0mm, var -35mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == -35mm
  horizontal([section.center, section.start])
  radius(section) == 12mm
}
noseTipRegion = region(segments = [noseTipSketch.section])

noseShoulderSketch = sketch(on = offsetPlane(YZ, offset = -900mm)) {
  section = circle(start = [var 112mm, var -12mm], center = [var 0mm, var -12mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == -12mm
  horizontal([section.center, section.start])
  radius(section) == 112mm
}
noseShoulderRegion = region(segments = [noseShoulderSketch.section])

forwardBodySketch = sketch(on = offsetPlane(YZ, offset = -560mm)) {
  section = circle(start = [var 188mm, var 18mm], center = [var 0mm, var 18mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == 18mm
  horizontal([section.center, section.start])
  radius(section) == 188mm
}
forwardBodyRegion = region(segments = [forwardBodySketch.section])

midBodySketch = sketch(on = YZ) {
  section = circle(start = [var 198mm, var 22mm], center = [var 0mm, var 22mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == 22mm
  horizontal([section.center, section.start])
  radius(section) == 198mm
}
midBodyRegion = region(segments = [midBodySketch.section])

rearBodySketch = sketch(on = offsetPlane(YZ, offset = 500mm)) {
  section = circle(start = [var 140mm, var 34mm], center = [var 0mm, var 34mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == 34mm
  horizontal([section.center, section.start])
  radius(section) == 140mm
}
rearBodyRegion = region(segments = [rearBodySketch.section])

tailShoulderSketch = sketch(on = offsetPlane(YZ, offset = 820mm)) {
  section = circle(start = [var 78mm, var 50mm], center = [var 0mm, var 50mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == 50mm
  horizontal([section.center, section.start])
  radius(section) == 78mm
}
tailShoulderRegion = region(segments = [tailShoulderSketch.section])

tailHubSketch = sketch(on = offsetPlane(YZ, offset = 1020mm)) {
  section = circle(start = [var 42mm, var 55mm], center = [var 0mm, var 55mm])
  horizontalDistance([ORIGIN, section.center]) == 0mm
  verticalDistance([ORIGIN, section.center]) == 55mm
  horizontal([section.center, section.start])
  radius(section) == 42mm
}
tailHubRegion = region(segments = [tailHubSketch.section])

fuselage = loft(
  [
    noseTipRegion,
    noseShoulderRegion,
    forwardBodyRegion,
    midBodyRegion,
    rearBodyRegion,
    tailShoulderRegion,
    tailHubRegion
  ],
  vDegree = 2,
  bezApproximateRational = true,
)
  |> scale(
       x = 1,
       y = 1,
       z = 0.82,
       global = false,
     )
  |> appearance(color = "#EEF1F2", roughness = 32)

hide([
  noseTipSketch,
  noseShoulderSketch,
  forwardBodySketch,
  midBodySketch,
  rearBodySketch,
  tailShoulderSketch,
  tailHubSketch
])

fuselage
