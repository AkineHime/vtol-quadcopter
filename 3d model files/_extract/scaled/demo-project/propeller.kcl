// Two-blade VTOL propeller
// Curved carbon blades and a compact central hub.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

propellerProfile = sketch(on = XY) {
  hubCircle = circle(start = [var 36mm, var 0mm], center = [var 0mm, var 0mm])

  leadingArc = arc(
    start = [var 40mm, var -20mm],
    end = [var 285mm, var -10mm],
    center = [var 146.5mm, var 377mm],
    direction = CCW,
  )
  tipArc = arc(
    start = [var 285mm, var -10mm],
    end = [var 295mm, var 10mm],
    center = [var 284mm, var 3mm],
    direction = CCW,
  )
  trailingArc = arc(
    start = [var 295mm, var 10mm],
    end = [var 40mm, var 18mm],
    center = [var 179.5mm, var 396.5mm],
    direction = CW,
  )
  rootEdge = line(start = [var 40mm, var 18mm], end = [var 40mm, var -20mm])

  coincident([hubCircle.center, ORIGIN])
  horizontal([hubCircle.center, hubCircle.start])
  radius(hubCircle) == 36mm

  coincident([leadingArc.end, tipArc.start])
  coincident([tipArc.end, trailingArc.start])
  coincident([trailingArc.end, rootEdge.start])
  coincident([rootEdge.end, leadingArc.start])

  horizontalDistance([ORIGIN, leadingArc.start]) == 40mm
  verticalDistance([ORIGIN, leadingArc.start]) == -20mm
  horizontalDistance([ORIGIN, leadingArc.center]) == 146.5mm
  verticalDistance([ORIGIN, leadingArc.center]) == 377mm
  horizontalDistance([ORIGIN, leadingArc.end]) == 285mm
  verticalDistance([ORIGIN, leadingArc.end]) == -10mm

  horizontalDistance([ORIGIN, tipArc.center]) == 284mm
  verticalDistance([ORIGIN, tipArc.center]) == 3mm
  horizontalDistance([ORIGIN, tipArc.end]) == 295mm
  verticalDistance([ORIGIN, tipArc.end]) == 10mm

  horizontalDistance([ORIGIN, trailingArc.center]) == 179.5mm
  verticalDistance([ORIGIN, trailingArc.center]) == 396.5mm
  horizontalDistance([ORIGIN, trailingArc.end]) == 40mm
  verticalDistance([ORIGIN, trailingArc.end]) == 18mm
}

hubRegion = region(segments = [propellerProfile.hubCircle])
bladeRegion = region(
  segments = [
    propellerProfile.leadingArc,
    propellerProfile.tipArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)

propellerHub = extrude(hubRegion, length = 30mm, symmetric = true)
  |> appearance(color = "#25282A", metalness = 52, roughness = 23)
firstBlade = extrude(bladeRegion, length = 7mm, symmetric = true)
  |> appearance(color = "#151719", metalness = 38, roughness = 24)
secondBlade = clone(firstBlade)
  |> rotate(axis = Z, angle = 180deg, global = true)

hide(propellerProfile)
propellerAssembly = [propellerHub, firstBlade, secondBlade]
