// Main wing half
// Swept tapered panel with a rounded outboard tip.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

wingProfile = sketch(on = XY) {
  leadingEdge = line(start = [var 0mm, var 0mm], end = [var 320mm, var 1520mm])
  tipEdge = arc(
    start = [var 320mm, var 1520mm],
    end = [var 610mm, var 1520mm],
    center = [var 465mm, var 1520mm],
    direction = CW,
  )
  trailingEdge = line(start = [var 610mm, var 1520mm], end = [var 560mm, var 0mm])
  rootEdge = line(start = [var 560mm, var 0mm], end = [var 0mm, var 0mm])

  coincident([leadingEdge.start, ORIGIN])
  coincident([leadingEdge.end, tipEdge.start])
  coincident([tipEdge.end, trailingEdge.start])
  coincident([trailingEdge.end, rootEdge.start])
  coincident([rootEdge.end, leadingEdge.start])

  horizontalDistance([ORIGIN, leadingEdge.end]) == 320mm
  verticalDistance([ORIGIN, leadingEdge.end]) == 1520mm
  horizontalDistance([ORIGIN, tipEdge.center]) == 465mm
  verticalDistance([ORIGIN, tipEdge.center]) == 1520mm
  horizontalDistance([ORIGIN, tipEdge.end]) == 610mm
  verticalDistance([ORIGIN, tipEdge.end]) == 1520mm
  horizontalDistance([ORIGIN, trailingEdge.end]) == 560mm
  verticalDistance([ORIGIN, trailingEdge.end]) == 0mm
}
wingRegion = region(
  segments = [
    wingProfile.leadingEdge,
    wingProfile.tipEdge
  ],
  intersectionIndex = -1,
  direction = CW,
)
wingHalf = extrude(wingRegion, length = 30mm, symmetric = true)
  |> appearance(color = "#F7F7F4", roughness = 28)

hide(wingProfile)
wingHalf
