// Twin-tail vertical fin
// Swept fin with a curved aerodynamic crown.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

finProfile = sketch(on = XZ) {
  rootEdge = line(start = [var 0mm, var 0mm], end = [var 280mm, var 0mm])
  trailingEdge = line(start = [var 280mm, var 0mm], end = [var 265mm, var 160mm])
  crownEdge = arc(
    start = [var 265mm, var 160mm],
    end = [var 70mm, var 245mm],
    center = [var 137.75mm, var 134.25mm],
    direction = CCW,
  )
  leadingEdge = line(start = [var 70mm, var 245mm], end = [var 0mm, var 0mm])

  coincident([rootEdge.start, ORIGIN])
  coincident([rootEdge.end, trailingEdge.start])
  coincident([trailingEdge.end, crownEdge.start])
  coincident([crownEdge.end, leadingEdge.start])
  coincident([leadingEdge.end, rootEdge.start])

  horizontalDistance([ORIGIN, rootEdge.end]) == 280mm
  verticalDistance([ORIGIN, rootEdge.end]) == 0mm
  horizontalDistance([ORIGIN, trailingEdge.end]) == 265mm
  verticalDistance([ORIGIN, trailingEdge.end]) == 160mm
  horizontalDistance([ORIGIN, crownEdge.center]) == 137.75mm
  verticalDistance([ORIGIN, crownEdge.center]) == 134.25mm
  horizontalDistance([ORIGIN, crownEdge.end]) == 70mm
  verticalDistance([ORIGIN, crownEdge.end]) == 245mm
}
finRegion = region(
  segments = [
    finProfile.rootEdge,
    finProfile.trailingEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
verticalFin = extrude(finRegion, length = 18mm, symmetric = true)
  |> appearance(color = "#F0F1EE", roughness = 31)

hide(finProfile)
verticalFin
