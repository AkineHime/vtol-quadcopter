// Airframe antenna
// Compact vertical communications mast.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

antennaProfile = sketch(on = XY) {
  antennaCircle = circle(start = [var 6mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([antennaCircle.center, ORIGIN])
  horizontal([
    antennaCircle.center,
    antennaCircle.start
  ])
  radius(antennaCircle) == 6mm
}
antennaRegion = region(segments = [antennaProfile.antennaCircle])
aframeAntenna = extrude(antennaRegion, length = 92mm, symmetric = true)
  |> appearance(color = "#202326", metalness = 30, roughness = 32)

hide(antennaProfile)
aframeAntenna
